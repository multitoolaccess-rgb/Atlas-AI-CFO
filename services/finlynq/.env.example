# services/finlynq/.env.example
#
# Copy to ``.env`` (or one level above — pydantic-settings reads it).
# Phase F2a: Finlynq points at the SAME DATABASE_URL the rules-service uses.
# Both services share the schema; Finlynq owns the write side, rules-service
# becomes a passthrough reader. When DB splits in a later phase, point this at
# Finlynq's own Postgres.
DATABASE_URL=postgresql+psycopg2://wealthiq:wealthiq@localhost:5432/wealthiq

# Auth — IMPORTANT: must match rules-service's JWT_SECRET or the devlogin
# cookie minted by rules-service is rejected by Finlynq's require_user dep.
# In dev both services share the dev default; in prod override this AND
# rules-service's. Phase F6 increases the security stance (no shared
# dev default) — see TODO marker in app/config.py.
JWT_SECRET=dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
LOCAL_USER=alex

# Server
ENVIRONMENT=development
APP_NAME=Finance Copilot
APP_VERSION=0.2.0   # Bumped from rules-service's 0.1.0 — Finlynq + parser/categorizer lives here now
API_HOST=127.0.0.1
API_PORT=8889
ATLAS_UI_PORT=3333
ATLAS_RULES_PORT=8888
ATLAS_FINLYNQ_PORT=8889
# Optional comma-separated development origins in addition to legacy and
# configured Atlas UI origins. Leave empty for the local default profile.
CORS_ALLOW_ORIGINS=
