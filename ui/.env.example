# ui/.env.example
#
# Canonical dev/CI env for the Finance Copilot UI. Copy to
# ``ui/.env.local`` (gitignored) and edit as needed:
#
#   cp ui/.env.example ui/.env.local
#
# Next.js auto-loads ``.env.local`` overriding any committed
# defaults. Leave variables UNSET to use the fallback baked into
# ``ui/lib/api.ts`` — that's the canonical local-dev setup.
#
# History note:
#   An earlier ``ui/.env.local`` hardcoded port ``8081`` (a stale
#   docker-compose port with nothing listening there). The real
#   uvicorn server runs on ``8000``, which is also the api.ts
#   default. We replaced the file with this ``.env.example`` so the
#   canonical contract propagates to every contributor instead of
#   living in one developer's gitignored file.

# IPv4-vs-IPv6 binding note (Phase 9 hardening):
#
#   Chromium on macOS resolves "localhost" via getaddrinfo as a
#   Happy-Eyeballs race between ::1 (IPv6) and 127.0.0.1 (IPv4).
#   When IPv6 wins, Chrome sends the request to `[::1]:8000`. The
#   rules-service binds to 127.0.0.1 ONLY (per start.sh), so the
#   IPv6 socket is closed, the connection is refused, and
#   Chromium then misreports the failure as a CORS error (because
#   no response = no CORS headers at all). Pinning the browser's
#   base URL to 127.0.0.1:8000 skips the DNS lookup entirely so
#   every clone picks up the IPv4 path reproducibly.
#
#   The Origin header Chrome sends with the actual request is
#   still `http://localhost:3000` (URL as-written, not the
#   resolved IP), so the rules-service's existing allow_origins
#   already matches — no backend CORS change is needed.

NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

