[TEMPLATE]
# ui/.env.example
#
# Canonical dev env for the Atlas UI. Copy to ``ui/.env.local``
# (gitignored) and edit as needed:
#
#   cp ui/.env.example ui/.env.local
#
# Next.js auto-loads ``.env.local`` overriding any committed
# defaults. Leave variables UNSET to use the fallback baked into
# ``ui/lib/api.ts`` — that's the canonical local-dev setup.
#
# Canonical ports (see ./start.sh):
#   UI      : 3333
#   Rules   : 8888   <- this is the API base URL the UI must reach
#   Finlynq : 8889
#
# ``./start.sh`` launches the UI with
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8888 automatically, so a
# plain ``./start.sh`` needs no .env.local at all. Set this variable
# here only when you run the UI against a non-canonical backend port
# (for example the isolated E2E harness, which owns Rules on :8000 and
# passes its own explicit base URL).
#
# IPv4-vs-IPv6 binding note:
#
#   Chromium on macOS resolves "localhost" via getaddrinfo as a
#   Happy-Eyeballs race between ::1 (IPv6) and 127.0.0.1 (IPv4).
#   When IPv6 wins, Chrome sends the request to `[::1]:8888`. The
#   rules-service binds to 127.0.0.1 ONLY (per start.sh), so the
#   IPv6 socket is closed, the connection is refused, and Chromium
#   then misreports the failure as a CORS error (because no response
#   = no CORS headers at all). Pinning the browser's base URL to
#   127.0.0.1:8888 skips the DNS lookup entirely so every clone picks
#   up the IPv4 path reproducibly.

NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8888

