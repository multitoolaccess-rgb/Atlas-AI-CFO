# Atlas local development profile. These defaults deliberately avoid the
# legacy Finance Copilot 3000/8000/8001 ports.
ATLAS_UI_PORT=3333
ATLAS_RULES_PORT=8888
ATLAS_FINLYNQ_PORT=8889
FINLYNQ_URL=http://127.0.0.1:8889
RULES_SERVICE_URL=http://127.0.0.1:8888

# Placeholders only. Do not put real credentials in a committed env file.
FINLYNQ_API_TOKEN=replace-with-local-placeholder
TELEGRAM_BOT_TOKEN=replace-with-local-placeholder
TELEGRAM_CHAT_ID=replace-with-local-placeholder
